# Copy these onto the server that depends on SpaGym.
# SPA_SYS_API_KEY is the same secret the SpaGym operator set as SPA_SYS_API_KEY.
# The URL is the SpaGym origin only: no /api suffix and no key.
# SPA_SYS_WEBHOOK_SECRET verifies check-in alerts. It is not the API key.

SPAGYM_API_URL=https://your-spagym-domain.example
SPA_SYS_API_KEY=paste-the-shared-secret-here
SPA_SYS_WEBHOOK_SECRET=paste-the-webhook-signing-secret-here
