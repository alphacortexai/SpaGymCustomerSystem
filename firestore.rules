rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return signedIn() && userDoc().status == 'approved';
    }

    function isAdmin() {
      return approved() && userDoc().role == 'Admin';
    }

    function rootEmail() {
      return 'alphacortexai@gmail.com';
    }

    function isRootToken() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == rootEmail();
    }

    function isPlatformAdmin() {
      return approved() && isRootToken();
    }

    function emailsMatch(value) {
      return request.auth.token.email is string
        && value is string
        && value.lower() == request.auth.token.email.lower();
    }

    function generalPermissions() {
      return {
        clients: { view: true, edit: false, delete: false, add: false },
        gym: { view: true, edit: false, delete: false, add: false },
        spa: { view: true, edit: false, delete: false, add: false },
        birthdays: { view: true, edit: false, delete: false, add: false },
        branches: { view: false, edit: false, delete: false, add: false },
        users: { view: false, edit: false }
      };
    }

    function isPendingGeneralProfile() {
      return emailsMatch(request.resource.data.email)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'General'
        && request.resource.data.status == 'pending'
        && request.resource.data.permissions == generalPermissions()
        && request.resource.data.assignedBranches is list
        && request.resource.data.assignedBranches.size() == 0
        && request.resource.data.spaIntakeBranches is list
        && request.resource.data.spaIntakeBranches.size() == 0;
    }

    function isRootAdminProfile() {
      return isRootToken()
        && emailsMatch(request.resource.data.email)
        && request.resource.data.email.lower() == rootEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'Admin'
        && request.resource.data.status == 'approved';
    }

    function isRootDocument() {
      return resource.data.email is string && resource.data.email.lower() == rootEmail();
    }

    // Only the signed-in root's own document is pinned. A different account that
    // already stored the root email can still be repaired by the root token.
    function protectsThisRootDocument() {
      return isRootDocument() && request.auth.uid == uid;
    }

    function rootDocumentStaysRoot() {
      return !protectsThisRootDocument() || (
        request.resource.data.role == 'Admin'
        && request.resource.data.status == 'approved'
        && request.resource.data.email is string
        && request.resource.data.email.lower() == rootEmail()
      );
    }

    function doesNotClaimRootEmail() {
      return !(request.resource.data.email is string && request.resource.data.email.lower() == rootEmail())
        || isRootDocument();
    }

    function privilegedUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'permissions', 'email']);
    }

    function isManagerOrAdmin() {
      return approved() && (userDoc().role == 'Admin' || userDoc().role == 'Manager');
    }

    function can(category, action) {
      return isAdmin() || (
        approved() &&
        userDoc().permissions[category][action] == true
      );
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && (
        isRootAdminProfile() || isPendingGeneralProfile()
      );
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isPlatformAdmin());
      allow update: if rootDocumentStaysRoot() && doesNotClaimRootEmail() && (
        isRootToken() || (
          !isRootDocument() && isAdmin() && privilegedUnchanged() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['spaIntakeBranches'])
        ) || (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'preferences', 'updatedAt'
          ])
        )
      );
      allow delete: if (isRootToken() && request.auth.uid != uid) || (isAdmin() && !isRootDocument());
    }

    match /clients/{clientId} {
      allow read: if can('clients', 'view') || can('birthdays', 'view');
      allow create: if can('clients', 'add');
      allow update: if can('clients', 'edit') || (
        can('birthdays', 'view') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'birthdayContactMethod',
          'birthdayCallStatus',
          'birthdayCalledById',
          'birthdayCalledByName',
          'birthdayCalledByRole',
          'birthdayCalledAt',
          'updatedAt'
        ])
      );
      allow delete: if can('clients', 'delete');
    }

    match /guestflowVisits/{visitId} {
      // GuestFlow writes through the authenticated server API (Admin SDK). Staff
      // can only read records with client-view permission and record check-outs
      // with client-edit permission.
      allow read: if can('clients', 'view');
      allow create: if false;
      allow update: if can('clients', 'edit') &&
        resource.data.checkedOutAt == null &&
        request.resource.data.checkedOutAt is timestamp &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'checkedOutAt', 'checkedOutBy', 'updatedAt'
        ]);
      allow delete: if isPlatformAdmin();
    }

    match /birthday_callers/{callerId} {
      allow read: if can('birthdays', 'view');
      allow create, update, delete: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if can('branches', 'view') || isManagerOrAdmin() || isPlatformAdmin();
      allow create: if can('branches', 'add');
      allow update: if can('branches', 'edit');
      allow delete: if can('branches', 'delete');
    }

    match /reports/{reportId} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.ownerId == request.auth.uid;
      allow update: if approved() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (approved() && resource.data.ownerId == request.auth.uid);
    }

    match /notes/{noteId} {
      allow read: if approved() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.visibility == 'all' ||
        (resource.data.visibility == 'branch' && resource.data.branch in userDoc().assignedBranches)
      );
      allow create: if approved() && request.resource.data.createdBy == request.auth.uid;
      allow update: if approved() && resource.data.createdBy == request.auth.uid;
      allow delete: if approved() && resource.data.createdBy == request.auth.uid;
    }

    match /invoices/{invoiceId} {
      allow read: if isManagerOrAdmin();
      allow create: if approved();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /invoiceTracking/{trackingId} {
      allow read: if isManagerOrAdmin();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    match /partnerCompanies/{companyId} {
      allow read: if isManagerOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Current application collections. Keep these separate by service so a
    // gym permission cannot accidentally grant access to spa records.
    match /membership_types/{membershipId} {
      allow read: if can('gym', 'view');
      allow create: if can('gym', 'add');
      allow update: if can('gym', 'edit');
      allow delete: if can('gym', 'delete');
    }

    match /spa_membership_types/{membershipId} {
      allow read: if can('spa', 'view');
      allow create: if can('spa', 'add');
      allow update: if can('spa', 'edit');
      allow delete: if can('spa', 'delete');
    }

    match /enrollments/{enrollmentId} {
      allow read: if can('gym', 'view');
      allow create: if can('gym', 'add');
      allow update: if can('gym', 'edit');
      allow delete: if can('gym', 'delete');
    }

    match /spa_enrollments/{enrollmentId} {
      allow read: if can('spa', 'view');
      allow create: if can('spa', 'add');
      allow update: if can('spa', 'edit');
      allow delete: if can('spa', 'delete');
    }

    match /access_logs/{logId} {
      allow read: if can('gym', 'view');
      allow create, update: if can('gym', 'add') || can('gym', 'edit');
      allow delete: if can('gym', 'delete');
    }

    match /spa_access_logs/{logId} {
      allow read: if can('spa', 'view');
      allow create, update: if can('spa', 'add') || can('spa', 'edit');
      allow delete: if can('spa', 'delete');
    }

    // Legacy collection paths retained for backward compatibility.
    match /memberships/{membershipId} {
      allow read: if can('gym', 'view') || can('spa', 'view');
      allow create, update: if can('gym', 'edit') || can('spa', 'edit');
      allow delete: if can('gym', 'delete') || can('spa', 'delete');
    }

    match /spaMemberships/{membershipId} {
      allow read: if can('spa', 'view');
      allow create, update: if can('spa', 'edit');
      allow delete: if can('spa', 'delete');
    }

    match /spaEnrollments/{enrollmentId} {
      allow read: if can('spa', 'view');
      allow create: if can('spa', 'add');
      allow update: if can('spa', 'edit');
      allow delete: if can('spa', 'delete');
    }

    match /importJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /timeline/{entryId} {
      allow read: if isAdmin();
      allow create: if approved();
      allow update, delete: if isAdmin();
    }

    match /userActivity/{entryId} {
      allow read: if isAdmin();
      allow create: if approved() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /userSessions/{entryId} {
      allow read: if isAdmin();
      allow create: if approved() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /counters/{counterId} {
      // Invoice generation is available to approved staff. The counter may
      // only be initialized once and may only advance by one per transaction.
      allow read: if approved();
      allow create: if approved() && counterId == 'invoiceCounter' && request.resource.data.current == 100000;
      allow update: if approved() && counterId == 'invoiceCounter' && request.resource.data.current == resource.data.current + 1;
      allow delete: if isAdmin();
    }

    match /spaSysIntegrations/{integrationId} {
      // SPA_SYS_API_V1 registrations are written by the Admin SDK. The browser
      // must not read key hashes or webhook secrets.
      allow read, write: if false;
    }

    match /spaSysUsage/{usageId} {
      // Per-key API and webhook counts are written by the Admin SDK.
      allow read, write: if false;
    }

    match /spaSysRequestLogs/{logId} {
      // Individual API and webhook results are written by the Admin SDK.
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
